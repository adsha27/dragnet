# Copy to .env and fill in values

# Anthropic — Haiku for classification, Sonnet for tailoring
ANTHROPIC_API_KEY=sk-ant-...

# Exa — company discovery, founder enrichment, LinkedIn contact finding
EXA_API_KEY=...

# Browserbase + Stagehand — Naukri scraping, LinkedIn connection requests
BROWSERBASE_API_KEY=...
BROWSERBASE_PROJECT_ID=...

# Reddit OAuth — register a free "script" app at reddit.com/prefs/apps
# Needed for referral thread scraping (r/developersIndia, r/cscareerquestions)
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...

# Postgres — run: docker run -d -e POSTGRES_PASSWORD=dragnet -p 5432:5432 postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:dragnet@localhost:5432/dragnet

# Gmail OAuth — see docs/gmail_setup.md
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_SENDER_ADDRESS=your@gmail.com

# Application identity — your details go here, NOT committed
APPLICANT_NAME=Your Name
APPLICANT_EMAIL=your@email.com
APPLICANT_PHONE=+91 ...
APPLICANT_GITHUB=https://github.com/yourusername
APPLICANT_LOCATION=Delhi, India

# YC Work at a Startup — needs session cookie (site blocks unauthenticated requests)
# Log in at workatastartup.com, copy the _session cookie value from DevTools
# HN scraper (hn_hiring) covers YC companies if this is not set
WAS_SESSION_COOKIE=_session=...

# GitHub — for OSS issue finder (5000 req/hour vs 60 without)
# Create at: github.com/settings/tokens → "Fine-grained" → public repo read-only
GITHUB_TOKEN=ghp_...

# Limits
MAX_CONCURRENT_SESSIONS=3
MAX_APPLICATIONS_PER_COMPANY_PER_DAY=1
MAX_FOUNDER_EMAILS_PER_DAY=15
GHOST_TIMEOUT_DAYS=14

# Human approval gate
APPROVAL_GATE_COUNT=50
APPROVAL_SAMPLE_RATE=0.10
