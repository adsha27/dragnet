// Generated by dragnet — do not edit. Edit resume_templates/base.typ or tailoring/resume.py.
// Generated: {{ generated_at }}
// Posting: {{ company }} - {{ title }}

#set page(
  margin: (x: 0.5in, y: 0.42in),
  paper: "a4",
)
#set text(font: ("Helvetica Neue", "Helvetica", "Arial"), size: 10pt, fill: black)
#set par(leading: 0.65em)
#show link: underline

// ── HEADER ──────────────────────────────────────────────────────────────────
#align(center)[
  #text(size: 20pt, weight: "bold")[{{ name }}]
  #v(0.15em)
  #text(size: 10pt)[
    {{ tagline }} #h(0.4em) · #h(0.4em)
    #link("mailto:{{ email }}")[{{ email_display }}] #h(0.4em) · #h(0.4em)
    {{ phone }} #h(0.4em) · #h(0.4em)
    #link("https://{{ github }}")[{{ github }}] #h(0.4em) · #h(0.4em)
    #link("https://{{ linkedin }}")[{{ linkedin }}]
  ]
]

#v(0.2em)
#line(length: 100%, stroke: 0.5pt)
#v(0.2em)

// ── SUMMARY ─────────────────────────────────────────────────────────────────
#text(size: 10.5pt)[{{ summary }}]

#v(0.4em)

// ── EXPERIENCE ──────────────────────────────────────────────────────────────
#text(weight: "bold", size: 11pt)[EXPERIENCE]
#line(length: 100%, stroke: 0.4pt)
#v(0.2em)

{% for role in experience %}
#grid(
  columns: (1fr, auto),
  column-gutter: 1em,
  align: (left, right),
  [#text(weight: "bold")[{{ role.title }}]], [{{ role.start }} - {{ role.end }}],
  [#text(style: "italic")[{{ role.company }}, {{ role.location }}]], [],
)
#v(0.1em)
#list(
{% for bullet in role.bullets %}
  [{{ bullet }}],
{% endfor %}
)
#v(0.25em)
{% endfor %}

// ── PROJECTS ────────────────────────────────────────────────────────────────
{% if projects %}
#text(weight: "bold", size: 11pt)[PROJECTS]
#line(length: 100%, stroke: 0.4pt)
#v(0.2em)

{% for proj in projects %}
#text(weight: "bold")[{{ proj.name }}] #h(1fr) #text(style: "italic")[{{ proj.stack }}]
#v(0.1em)
#list(
{% for bullet in proj.bullets %}
  [{{ bullet }}],
{% endfor %}
)
#v(0.3em)
{% endfor %}
{% endif %}

// ── SKILLS ──────────────────────────────────────────────────────────────────
#text(weight: "bold", size: 11pt)[TECHNICAL SKILLS]
#line(length: 100%, stroke: 0.4pt)
#v(0.15em)

#table(
  columns: (auto, 1fr),
  stroke: none,
  inset: (x: 0pt, y: 3.5pt),
  [#text(weight: "bold")[Languages:]], [{{ skills.languages }}],
  [#text(weight: "bold")[Backend:]], [{{ skills.backend }}],
  [#text(weight: "bold")[AI and Agents:]], [{{ skills.ai_agents }}],
  [#text(weight: "bold")[Infrastructure:]], [{{ skills.infra }}],
)

#v(0.3em)

// ── EDUCATION ───────────────────────────────────────────────────────────────
#text(weight: "bold", size: 11pt)[EDUCATION]
#line(length: 100%, stroke: 0.4pt)
#v(0.15em)

{% for edu in education %}
#grid(
  columns: (1fr, auto),
  column-gutter: 1em,
  align: (left, right),
  [#text(weight: "bold")[{{ edu.degree }}]], [{{ edu.graduation }}],
  [#text(style: "italic")[{{ edu.institution }}. CGPA {{ edu.cgpa }}]], [],
)
{% endfor %}
